{
  "name": "evolver-plugin",
  "version": "1.0.0",
  "description": "Evolver recall, evidence-backed reuse reports and verified-turn drafts for Kimi Code.",
  "repository": "https://github.com/EvoMap/evolver-agent-plugin",
  "license": "MIT",
  "hooks": [
    { "event": "SessionStart", "command": "node bin/hook.mjs kimi SessionStart", "timeout": 3 },
    { "event": "UserPromptSubmit", "command": "node bin/hook.mjs kimi UserPromptSubmit", "timeout": 10 },
    { "event": "TurnStarted", "command": "node bin/hook.mjs kimi TurnStarted", "timeout": 3 },
    { "event": "PreToolUse", "command": "node bin/hook.mjs kimi PreToolUse", "timeout": 3 },
    { "event": "Stop", "command": "node bin/hook.mjs kimi Stop", "timeout": 3 },
    { "event": "StopFailure", "command": "node bin/hook.mjs kimi StopFailure", "timeout": 3 },
    { "event": "Interrupt", "command": "node bin/hook.mjs kimi Interrupt", "timeout": 3 },
    { "event": "SessionEnd", "command": "node bin/hook.mjs kimi SessionEnd", "timeout": 3 },
    { "event": "Notification", "command": "node bin/hook.mjs kimi Notification", "timeout": 3 }
  ]
}
