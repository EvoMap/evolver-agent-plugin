{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "process", "command": "node", "args": ["${ZCODE_PLUGIN_ROOT}/bin/hook.mjs", "zcode", "SessionStart"], "timeoutMs": 4000 }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "process", "command": "node", "args": ["${ZCODE_PLUGIN_ROOT}/bin/hook.mjs", "zcode", "UserPromptSubmit"], "timeoutMs": 6000 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          { "type": "process", "command": "node", "args": ["${ZCODE_PLUGIN_ROOT}/bin/hook.mjs", "zcode", "PreToolUse"], "timeoutMs": 4000 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          { "type": "process", "command": "node", "args": ["${ZCODE_PLUGIN_ROOT}/bin/hook.mjs", "zcode", "PostToolUse"], "timeoutMs": 4000 }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "^Bash$",
        "hooks": [
          { "type": "process", "command": "node", "args": ["${ZCODE_PLUGIN_ROOT}/bin/hook.mjs", "zcode", "PostToolUseFailure"], "timeoutMs": 4000 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "process", "command": "node", "args": ["${ZCODE_PLUGIN_ROOT}/bin/hook.mjs", "zcode", "Stop"], "timeoutMs": 4000 }
        ]
      }
    ]
  }
}
